#!/bin/sh
set -e
if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --global disable deco-daemon.service >/dev/null 2>&1 || true
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
      systemctl --machine="${SUDO_USER}@.host" --user disable --now deco-daemon.service >/dev/null 2>&1 || true
    fi
  fi
fi
exit 0
