[Unit]
Description=XP-Pen Deco 02 userspace driver
After=graphical-session.target

[Service]
Type=dbus
BusName=it.bwlab.DecoDriver
ExecStart=%h/.local/bin/deco-daemon
Environment=RUST_LOG=deco_daemon=info,deco_protocol=info
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
